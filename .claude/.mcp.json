{
  "mcpServers": {
    "Memory Project State Vector Graph": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "Chain-of-Thought Tool for Sequential-Thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "Robust Web Browser": {
      "command": "uv",
      "args": [
        "tool",
        "run",
        "web-browser-mcp-server"
      ],
      "env": {
        "REQUEST_TIMEOUT": "30"
      }
    }
  }
}